# AI List Assist - Environment Variables Example
# Copy to .env and fill in real values. Never commit .env.

# Flask
SECRET_KEY=change-me-in-production
API_KEY=dev_api_key
FLASK_ENV=development
FLASK_APP=app_enhanced.py

# Data
DATA_DIR=./data

# Google / Gemini
GOOGLE_API_KEY=
GEMINI_API_KEY=

# eBay
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_CATEGORY_TREE_ID=0
EBAY_REDIRECT_URI=
EBAY_SANDBOX=true

# Optional integrations
PERPLEXITY_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database (local SQLite by default; Postgres optional)
DATABASE_URL=
REDIS_URL=
