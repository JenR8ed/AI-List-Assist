# =============================================================================
# AI List Assist — Environment Configuration Template
# Copy this file to `.env` and fill in your credentials.
# NEVER commit `.env` or real secrets to version control.
# =============================================================================

# Flask & API Security
SECRET_KEY=replace-with-a-strong-random-secret-key
API_KEY=replace-with-your-bearer-api-key
FLASK_DEBUG=False
# Set a strong local-only UI password; never expose the local login publicly.
LOCAL_UI_PASSWORD=
# Only use 1 for localhost HTTP development; session cookies otherwise require HTTPS.
LOCAL_HTTP_DEV=0
# Default OFF. Requires approved stored drafts and an explicit opt-in to publish.
ENABLE_EBAY_PUBLISHING=0
DATA_DIR=.

# Google AI (Cloud Vision + Gemini REST Client)
GOOGLE_API_KEY=your-google-cloud-and-gemini-api-key

# eBay Developer Credentials (Sandbox or Production)
EBAY_CLIENT_ID=your-ebay-client-id
EBAY_CLIENT_SECRET=your-ebay-client-secret
EBAY_DEV_ID=your-ebay-dev-id
EBAY_RU_NAME=http://localhost:5000/api/ebay/oauth/callback
EBAY_CATEGORY_TREE_ID=0

# Optional pre-seeded OAuth tokens
EBAY_ACCESS_TOKEN=
EBAY_REFRESH_TOKEN=

# Optional Telegram Bot
TELEGRAM_BOT_TOKEN=

# Optional PostgreSQL & Redis (for docker-compose.db.yml / seed_db.py)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ebay_market_data
POSTGRES_USER=ai_user
POSTGRES_PASSWORD=ai_password
REDIS_HOST=localhost
REDIS_PORT=6379
PERPLEXITY_API_KEY=

# eBay Sell Account API Business Policy IDs (used in Offer API)
EBAY_FULFILLMENT_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
